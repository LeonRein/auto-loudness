[Unit]
Description=Panel icon for auto-loudness (shows whether audio goes through Loudness)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/auto-loudness tray
Restart=on-failure
RestartSec=5
# a curve window opened from the icon stays open when the icon restarts
KillMode=process

[Install]
WantedBy=graphical-session.target
